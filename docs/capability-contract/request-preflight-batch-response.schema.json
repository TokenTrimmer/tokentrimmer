          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "standard_cost_usd_low": {
          "format": "double",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "standard_input_rate_usd_per_million": {
