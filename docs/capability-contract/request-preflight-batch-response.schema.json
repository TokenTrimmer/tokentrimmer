      "properties": {
        "code": {
          "enum": [
            "choose_registered_provider_or_model",
            "configure_provider_credential",
            "retry_preflight_or_contact_operator",
            "change_model_or_required_capabilities",
            "reduce_declared_tokens_or_choose_model",
            "execute_request_and_handle_result"
          ],
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/CapabilityReason"
        },
        "required_before_request": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "reason",
        "required_before_request"
      ],
      "type": "object"
    },
    "PreflightCostEvidence": {
      "description": "Cost interval under one responder's standard fresh-input/output catalog rates. This is a projection, not provider-observed pricing, a quote, a reservation, settlement, or an enforced spending limit.",
      "properties": {
        "input_tokens_high": {
          "format": "uint64",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens_low": {
          "description": "Low/high token assumptions used for the interval. When input is not declared, the range spans zero through the responder's catalog limit.",
          "format": "uint64",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens_high": {
          "format": "uint64",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens_low": {
          "description": "The low output assumption is zero; the high value is the caller's requested maximum or, when omitted, the responder's catalog limit.",
          "format": "uint64",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "$ref": "#/$defs/CapabilityReason"
        },
        "source": {
          "enum": [
            "registered_provider_pricing_catalog",
            "not_negotiated"
          ],
          "type": "string"
        },
