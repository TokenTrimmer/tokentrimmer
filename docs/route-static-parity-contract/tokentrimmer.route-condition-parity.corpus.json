{
  "corpus": {
    "id": "tokentrimmer.route-condition-parity-corpus",
    "version": 1
  },
  "route_contract": {
    "id": "tokentrimmer.route.v1",
    "version": 1
  },
  "condition_fields": [
    {
      "field": "model_in",
      "matcher": "exact_set",
      "dashboard": "set",
      "parity": "Exact decoded-string equality on both sides. Neither the canonical matcher nor the dashboard safe fragment trims or case-folds model names; whitespace padding is compared verbatim."
    },
    {
      "field": "input_tokens_lt",
      "matcher": "strict_upper_bound_u32",
      "dashboard": "strict_upper_bound_u32",
      "parity": "Strict u32 upper bound. A threshold of 0 is wire-valid but unsatisfiable (no u32 is < 0), so the dashboard safe fragment fails closed on it; the matcher evaluates it as an always-not-matched active condition."
    },
    {
      "field": "input_tokens_gt",
      "matcher": "strict_lower_bound_u32",
      "dashboard": "strict_lower_bound_u32",
      "parity": "Strict u32 lower bound. A threshold of U32_MAX is unsatisfiable, so the dashboard safe fragment fails closed on it."
    },
    {
      "field": "tag_equals",
      "matcher": "exact",
      "dashboard": "exact",
      "parity": "Exact decoded-string equality against the request tag; no trimming or case-folding on either side."
    },
    {
      "field": "has_images",
      "matcher": "optional_bool",
      "dashboard": "exact_bool",
      "parity": "Option<bool> equality: Some(false) is an active requirement of no-image, distinct from the field being absent. The dashboard safe fragment keeps the explicit bool verbatim."
    },
    {
      "field": "has_audio",
      "matcher": "optional_bool",
      "dashboard": "exact_bool",
      "parity": "Option<bool> equality, same semantics as has_images."
    },
    {
      "field": "has_documents",
      "matcher": "optional_bool",
      "dashboard": "exact_bool",
      "parity": "Option<bool> equality, same semantics as has_images."
    },
    {
      "field": "content_type",
      "matcher": "exact",
      "dashboard": "exact",
      "parity": "Exact decoded-string equality against the dominant content kind. An observed-but-unclassifiable request (None) never equals a wanted kind and is not treated as unavailable."
    },
    {
      "field": "prompt_contains_any_of",
      "matcher": "or_of_substrings_unicode_lowercase",
      "dashboard": "or_of_substrings_ascii_only",
      "parity": "Both sides lower-case the decoded keyword and the request text and use substring containment (OR across keywords) WITHOUT trimming. The dashboard's safe fragment only reasons about fully-ASCII keywords: a non-ASCII keyword makes the region fail closed (\"not proven\"), while the canonical matcher lower-cases with full Unicode. This is the pinned non-ASCII prompt parity contract: runtime executes, advisory fails closed."
    },
    {
      "field": "estimated_cost_gt",
      "matcher": "strict_lower_bound_f64_nonnegative",
      "dashboard": "strict_lower_bound_nonnegative",
      "parity": "Strict nonnegative dollar lower bound. A negative threshold is runtime-comparable but outside the dashboard safe fragment (fails closed)."
    },
    {
      "field": "estimated_cost_lt",
      "matcher": "strict_upper_bound_f64_nonnegative",
      "dashboard": "strict_upper_bound_nonnegative",
      "parity": "Strict nonnegative dollar upper bound. An empty gt>=lt interval is unsatisfiable, so the dashboard safe fragment fails closed on it."
    },
    {
      "field": "upstream_latency_ms_p95_gt",
      "matcher": "strict_lower_bound_u32",
      "dashboard": "strict_lower_bound_u32",
      "parity": "Strict u32 lower bound; U32_MAX is unsatisfiable and fails closed."
    },
    {
      "field": "not_reasoning_class",
      "matcher": "active_bool",
      "dashboard": "active_bool",
      "parity": "true is an active non-reasoning requirement; false is inactive on both sides."
    }
  ],
  "prompt_cases": [
    {
      "id": "unicode_lowercase_cafe_upper_keyword",
      "keywords": ["CAFÉ"],
      "prompt": "Please review the Café invoice",
      "expected_match": true,
      "dashboard_region": null,
      "note": "Full Unicode lowercase maps both CAFÉ and Café to café; the runtime matcher matches. The keyword is non-ASCII, so the dashboard safe fragment fails closed."
    },
    {
      "id": "unicode_lowercase_cafe_upper_prompt",
      "keywords": ["café"],
      "prompt": "Serve more CAFÉ please",
      "expected_match": true,
      "dashboard_region": null
    },
    {
      "id": "german_sharp_s_is_not_expanded",
      "keywords": ["STRASSE"],
      "prompt": "fahren auf der straße",
      "expected_match": false,
      "dashboard_region": { "prompt_keywords": ["strasse"], "not_reasoning_class": false },
      "note": "Full Unicode lowercase does NOT expand ß to ss: strasse is not a substring of straße. The ASCII-only keyword IS admitted by the dashboard fragment; the runtime lower-cases it identically (STRASSE -> strasse). The dashboard can reason about this keyword and, like the matcher, cannot prove a match against a prompt containing ß."
    },
    {
      "id": "greek_uppercase_lowercases_fully",
      "keywords": ["ΑΘΉΝΑ"],
      "prompt": "Είμαι στην αθήνα σήμερα",
      "expected_match": true,
      "dashboard_region": null
    },
    {
      "id": "cyrillic_uppercase_lowercases_fully",
      "keywords": ["МОСКВА"],
      "prompt": "привет москва сегодня",
      "expected_match": true,
      "dashboard_region": null
    },
    {
      "id": "turkish_dotted_i_keeps_combining_dot",
      "keywords": ["İSTANBUL"],
      "prompt": "istanbul ist überall",
      "expected_match": false,
      "dashboard_region": null,
      "note": "Full Unicode lowercase maps dotted İ to i + U+0307 combining dot; it never ASCII-folds to a bare i, so istanbul with a plain i is not a substring. Pins the matcher's exact Unicode behavior."
    },
    {
      "id": "ascii_keyword_matches_inside_non_ascii_prompt",
      "keywords": ["refactor"],
      "prompt": "refactor ✓ café, merci",
      "expected_match": true,
      "dashboard_region": { "prompt_keywords": ["refactor"], "not_reasoning_class": false },
      "note": "An ASCII keyword is admitted by the dashboard safe fragment even when the rest of the prompt text is non-ASCII."
    },
    {
      "id": "json_escape_replace_before_case_analysis",
      "keywords": ["\u00e9tude"],
      "prompt": "Complete the ÉTUDE now",
      "expected_match": true,
      "dashboard_region": null,
      "note": "The corpus JSON escape \\u00e9 is replaced once during decoding (the shared decode/replace semantic). Both sides then analyze the decoded keyword étude: the matcher lower-cases it Unicode-wise and matches ÉTUDE, while the dashboard's ASCII gate now sees non-ASCII and fails closed. Decode happens before either side's case analysis."
    },
    {
      "id": "no_trim_space_padded_keyword_does_not_match_bare_word",
      "keywords": ["\u0020refactor\u0020"],
      "prompt": "refactor this now",
      "expected_match": false,
      "dashboard_region": { "prompt_keywords": [" refactor "], "not_reasoning_class": false },
      "note": "Neither side trims: the padded keyword refactor (decoded from \\u0020) only matches text that literally contains the surrounding spaces. A bare leading word is not matched, and the dashboard keeps the padded keyword verbatim (lower-cased only)."
    },
    {
      "id": "space_padded_keyword_matches_padded_prompt",
      "keywords": ["\u0020refactor\u0020"],
      "prompt": "please refactor this block",
      "expected_match": true,
      "dashboard_region": { "prompt_keywords": [" refactor "], "not_reasoning_class": false },
      "note": "The padded keyword IS a substring of text that includes surrounding spaces. Padding is meaningful in both directions and is preserved identically on both sides."
    }
  ],
  "field_cases": [
    {
