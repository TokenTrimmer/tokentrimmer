    },
    {
      "id": "tag_equals_mismatch_no_trim",
      "field": "tag_equals",
      "conditions": { "tag_equals": "prod" },
      "features": { "model": "gpt-4o", "input_tokens": 100, "tag": " prod " },
      "expected_outcome": "not_matched",
      "expected_match": false,
      "dashboard_region": { "tag_equals": "prod", "not_reasoning_class": false },
      "note": "Exact tag equality: the observed padded tag never equals prod; the dashboard keeps wanted tags verbatim."
    },
    {
      "id": "has_images_true_match",
      "field": "has_images",
