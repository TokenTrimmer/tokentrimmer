  "overlap_cases": [
    {
      "id": "equal_priority_may_overlap_created_at_order",
      "routes": [
        {
          "name": "A",
          "id": "10000000-0000-0000-0000-000000000002",
          "priority": 100,
          "created_at": "2026-01-01T00:00:00Z",
          "conditions": { "model_in": ["gpt-4o"] }
        },
        {
          "name": "B",
          "id": "10000000-0000-0000-0000-000000000001",
          "priority": 100,
          "created_at": "2026-02-01T00:00:00Z",
          "conditions": { "model_in": ["gpt-4o"], "tag_equals": "prod" }
        }
      ],
      "requests": [
        {
          "id": "r1",
          "features": { "model": "gpt-4o", "input_tokens": 100, "tag": "prod" },
          "expected_winner": "A",
          "note": "Both match a gpt-4o/prod request; A is created earlier and wins under created_at ASC even though B has the lower UUID."
        }
      ],
      "pairs": [
        { "candidate": "A", "subject": "B", "relation": "equal", "expected": "may_overlap" },
        { "candidate": "B", "subject": "A", "relation": "equal", "expected": "may_overlap" }
      ]
    },
    {
      "id": "equal_priority_duplicate_id_asc_tiebreak",
      "routes": [
        {
          "name": "A",
          "id": "10000000-0000-0000-0000-000000000002",
          "priority": 100,
          "created_at": "2026-01-01T00:00:00Z",
          "conditions": { "model_in": ["gpt-4o"], "tag_equals": "prod" }
        },
        {
          "name": "B",
          "id": "10000000-0000-0000-0000-000000000001",
          "priority": 100,
          "created_at": "2026-01-01T00:00:00Z",
          "conditions": { "model_in": ["gpt-4o"], "tag_equals": "prod" }
        }
      ],
      "requests": [
        {
          "id": "r1",
          "features": { "model": "gpt-4o", "input_tokens": 100, "tag": "prod" },
          "expected_winner": "B",
          "note": "Byte-identical condition objects at the same priority; B (lower UUID) is the persisted earlier-order winner under the id ASC tie-break. The dashboard's exact-duplicate path flags this as identical_conditions_equal_priority_earlier_order (this corpus pins the shared may_overlap/order semantics, not the dashboard's duplicate finding text)."
        }
      ],
      "pairs": [
        { "candidate": "A", "subject": "B", "relation": "equal", "expected": "may_overlap" },
        { "candidate": "B", "subject": "A", "relation": "equal", "expected": "may_overlap" }
      ]
    },
    {
      "id": "equal_priority_disjoint_has_images",
      "routes": [
        {
          "name": "A",
          "id": "10000000-0000-0000-0000-000000000001",
          "priority": 100,
          "created_at": "2026-01-01T00:00:00Z",
          "conditions": { "has_images": true }
