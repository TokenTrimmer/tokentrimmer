    },
    {
      "id": "estimated_cost_gt_negative_threshold_runs_but_fails_closed",
      "field": "estimated_cost_gt",
      "conditions": { "estimated_cost_gt": -0.5 },
      "features": { "model": "gpt-4o", "input_tokens": 100, "estimated_cost_usd": 0.1 },
      "expected_outcome": "matched",
      "expected_match": true,
      "dashboard_region": null,
