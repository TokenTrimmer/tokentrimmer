{
  "name": "@tokentrimmer/client",
  "version": "0.1.0",
  "description": "Thin wrapper around the OpenAI Node SDK that routes through TokenTrimmer Gateway.",
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gateway",
    "cost-optimization"
  ],
  "homepage": "https://tokentrimmer.com",
  "bugs": "https://github.com/tokentrimmer/tokentrimmer/issues",
  "license": "Apache-2.0",
  "author": "TokenTrimmer Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokentrimmer/tokentrimmer.git",
    "directory": "sdk-typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./semconv": {
      "import": "./dist/semconv.js",
      "types": "./dist/semconv.d.ts"
    },
    "./vercel": {
      "import": "./dist/vercel.js",
      "types": "./dist/vercel.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openai": "^6.45.0",
    "ai": ">=3.0.0",
    "@opentelemetry/api": ">=1.0.0 <2.0.0",
    "unpdf": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": false
    },
    "ai": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "openai": "^6.45.0",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca"
}
