# Copy to .env.local for development. NEVER commit real secrets.

# --- Database / cache ---
DATABASE_URL=postgres://tt:tt_dev@localhost:5432/tokentrimmer
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tokentrimmer-dev
S3_ACCESS_KEY=tt_dev
S3_SECRET_KEY=tt_dev_password

# --- Email (mailpit locally, Resend in prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Provider API keys (only set what you're testing) ---
# These are CUSTOMER credentials in production; in dev they're for our own dogfooding.
# With a Postgres credential store configured (DATABASE_URL + TT_MASTER_KEY) the
# gateway is BYO-only: these env keys are NEVER served to orgs unless
# TT_ALLOW_ENV_CREDENTIAL_FALLBACK=1 is set (below).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# DANGER — single-tenant self-host / dogfood ONLY. Set to 1 to serve the env
# provider keys above to any org that has no stored credential. On a
# multi-tenant gateway this lets every org spend on the operator's keys
# (provider-ToS / resale exposure). Leave unset for BYO-only (the default).
#TT_ALLOW_ENV_CREDENTIAL_FALLBACK=1

# --- Encryption (XChaCha20-Poly1305 root key for provider credential storage) ---
# Generate with: openssl rand -hex 32
TT_MASTER_KEY=

# --- Reliability: circuit breaker, failover & route timeouts ---
# All optional. Each falls back to the compiled default (shown) when unset or
# unparseable — an unparseable value logs a warning and never panics, so the
# gateway's default behavior is byte-identical when none of these are set.
#
# Consecutive upstream failures before a provider's circuit OPENS (clamped >= 1).
#TT_BREAKER_FAILURE_THRESHOLD=5
# Seconds a circuit stays open before admitting a single half-open trial probe.
#TT_BREAKER_COOLDOWN_SECS=30
# Per-candidate retry cap when failing over across a chain (>1 candidate),
# bounding worst-case upstream calls to candidates * this (clamped >= 1).
#TT_FAILOVER_CHAINED_MAX_ATTEMPTS=2
# Request timeout (secs) for non-streaming routes (models, embeddings, etc.).
#TT_ROUTE_TIMEOUT_SECS=60
# Request timeout (secs) ceiling for the streaming completion routes.
#TT_STREAMING_TIMEOUT_SECS=600

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
RUST_LOG=info,tt_core=debug,tt_provider_anthropic=debug
